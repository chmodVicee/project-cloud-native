          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Broker arriba', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.rabbitmq_version).to.be.a('string');",
                  "});"
