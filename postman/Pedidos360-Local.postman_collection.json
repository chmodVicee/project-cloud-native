    {
      "name": "01 — Usuarios (8083)",
      "description": "Registro, login y perfil. Genera el JWT que usan el BFF y los endpoints protegidos.",
      "item": [
        {
          "name": "Registrar usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sufijo aleatorio para que la colección se pueda reejecutar sin chocar",
                  "const s = Date.now().toString().slice(-6);",
                  "pm.collectionVariables.set('username', 'user' + s);",
                  "pm.collectionVariables.set('userEmail', 'user' + s + '@test.cl');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve token', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('jwt', b.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{usersUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Guarda el JWT', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('jwt', b.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{usersUrl}}/api/auth/login"
          }
        },
        {
          "name": "Perfil del usuario (JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Es el usuario autenticado', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.username).to.eql(pm.collectionVariables.get('username'));",
                  "  pm.expect(b.role).to.eql('USER');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{usersUrl}}/api/users/profile"
          }
        },
        {
          "name": "Listar usuarios (solo ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Un usuario recién registrado es USER → 403 es la respuesta correcta",
                  "pm.test('200 con rol ADMIN, 403 con rol USER', () => {",
                  "  pm.expect([200, 403]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Devuelve lista', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{usersUrl}}/api/users"
          }
        },
        {
          "name": "Login con credenciales inválidas → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza credenciales incorrectas', () => {",
                  "  pm.expect([400, 401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"password-incorrecta\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{usersUrl}}/api/auth/login"
          }
        }
      ]
    },
