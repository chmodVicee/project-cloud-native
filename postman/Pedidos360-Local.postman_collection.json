                  "  pm.expect(b.messageCount).to.eql(0);",
                  "  pm.expect(b.consumerCount).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbitUrl}}/api/rabbit/queues/{{queueName}}"
          }
        },
