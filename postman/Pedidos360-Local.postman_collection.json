        {
          "name": "RabbitMQ — colas del sistema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Existen las colas de orders', () => {",
                  "  const names = pm.response.json().map(q => q.name);",
                  "  pm.expect(names).to.include('orders.notifications.queue');",
                  "  pm.expect(names).to.include('orders.cloud-bridge.queue');",
                  "  pm.expect(names).to.include('orders.notifications.dlq');",
                  "});",
                  "pm.test('Consumidores activos', () => {",
                  "  const q = pm.response.json().find(x => x.name === 'orders.notifications.queue');",
                  "  pm.expect(q.consumers).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
