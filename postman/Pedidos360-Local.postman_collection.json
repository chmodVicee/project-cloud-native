    {
      "name": "04 — Rabbit Admin (8084)",
      "description": "Crea y elimina recursos propios (prefijo demo.*) sin tocar los del sistema.",
      "item": [
        {
          "name": "Crear exchange",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Nombres únicos para no chocar en reejecuciones",
                  "const s = Date.now();",
                  "pm.collectionVariables.set('exchangeName', 'demo.exchange.' + s);",
                  "pm.collectionVariables.set('queueName', 'demo.queue.' + s);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Exchange topic creado', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.name).to.eql(pm.collectionVariables.get('exchangeName'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
