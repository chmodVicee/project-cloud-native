    {
      "name": "03 — Pedidos (8082)",
      "description": "Requiere el header X-User-Email. Genera orderId y dispara el flujo RabbitMQ → Pub/Sub.",
      "item": [
        {
          "name": "Crear pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Guarda orderId y nace RECIBIDO', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql('RECIBIDO');",
                  "  pm.expect(b.total).to.be.a('number');",
                  "  pm.collectionVariables.set('orderId', b.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
